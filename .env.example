GROQ_API_KEY=
GROQ_API_KEY_2=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
DEEPSEEK_API_KEY=
HUGGINGFACE_API_KEY=
JINA_API_KEY=
MIXEDBREAD_API_KEY=
VOYAGE_API_KEY=

HUMANONN_MAIN_PROVIDER=groq
HUMANONN_MAIN_MODEL=llama-3.3-70b-versatile
HUMANONN_FAST_PROVIDER=groq
HUMANONN_FAST_MODEL=llama-3.1-8b-instant
HUMANONN_JSON_PROVIDER=groq
HUMANONN_JSON_MODEL=llama-3.3-70b-versatile
HUMANONN_VISION_PROVIDER=gemini
HUMANONN_VISION_MODEL=gemini-2.5-flash
HUMANONN_FIX_PROVIDER=deepseek
HUMANONN_FIX_MODEL=deepseek-chat
HUMANONN_EMBEDDINGS_PROVIDER=groq
HUMANONN_EMBEDDINGS_MODEL=llama-3.1-8b-instant

HUMANONN_HEADLESS=true
HUMANONN_TIMEOUT_MS=30000
HUMANONN_NAVIGATION_TIMEOUT_MS=30000
HUMANONN_NETWORKIDLE_TIMEOUT_MS=12000
HUMANONN_TERMINAL_LOGS=true
HUMANONN_RENDER_WAIT_MS=700
HUMANONN_INTERACTION_WAIT_MS=180
HUMANONN_ACTIVE_WAIT_MS=140
HUMANONN_STABILITY_WAIT_MS=220
HUMANONN_HOVER_TIMEOUT_MS=4000
HUMANONN_STABILITY_CHECKS=8
HUMANONN_PASS2_WAIT_MULTIPLIER=1.6
HUMANONN_PASS3_WAIT_MULTIPLIER=2.4
HUMANONN_NO_LLM=false
HUMANONN_LLM_ADJUSTMENT_GATE=false
HUMANONN_LLM_ADJUSTMENT_MULTIPLIER_ENABLED=true
HUMANONN_LLM_ADJUSTMENT_EVIDENCE_FLOOR=0.35
HUMANONN_LLM_ADJUSTMENT_SINGLE_SOURCE_CAP=5.0
HUMANONN_LLM_ADJUSTMENT_HEADROOM_ENABLED=true
HUMANONN_SMART_SCORING_GATE=false
HUMANONN_SMART_SUMMARY=false
HUMANONN_DYNAMIC_FINDINGS=false
HUMANONN_PRODUCTION=false
HUMANONN_PROMPT_PATH=/app/prompts/agent_system.md
HUMANONN_LIVE_SITE_SCRAPING=true
# Smart sampling / selective sampling settings
# Confidence band low/high (0.0-1.0)
HUMANONN_SMART_CONF_LOW=0.35
HUMANONN_SMART_CONF_HIGH=0.65
# Center band for highest-priority sampling
HUMANONN_SMART_CENTER_LOW=0.45
HUMANONN_SMART_CENTER_HIGH=0.55
# Top-K ambiguous signals to send per repo and caps
HUMANONN_SMART_TOP_K=15
HUMANONN_SMART_MAX_PER_REPO=20
HUMANONN_SMART_GLOBAL_CAP=100
# Probability to sample outside the band (0.0-1.0)
HUMANONN_SMART_SAMPLE_OUTSIDE_PCT=0.05
# Cache TTL (days) for evidence hash caching
HUMANONN_SMART_CACHE_TTL_DAYS=7
# Enable in-process LLM response cache (true/false). When enabled, deterministic
# LLM calls (low temperature) will be cached to avoid repeated API calls.
HUMANONN_LLM_CACHE_ENABLED=false
# TTL (days) for LLM response cache entries
HUMANONN_LLM_CACHE_TTL_DAYS=7
